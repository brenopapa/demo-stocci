WITH
sa1_clientes AS (
  SELECT
    mdmTenantId,
    company_group,
    A1_FILIAL,
    TRIM(A1_COD) AS A1_COD,
    TRIM(A1_LOJA) AS A1_LOJA,
    A1_NOME,
    A1_CGC,
    A1_MUN,
    A1_EST,
    A1_EMAIL,
    A1_TEL,
    Deleted,
    mdmDeleted,
    protheus_pk,
    mdmEntityType,
    _ingestionDatetime,
    mdmCounterForEntity,
    ROW_NUMBER() OVER (
      PARTITION BY mdmTenantId, protheus_pk
      ORDER BY _ingestionDatetime DESC, mdmCounterForEntity DESC
    ) AS ranking
  FROM ingestion_stg_protheus_carol_sa1
  WHERE TRIM(Deleted) = 'false'
),

sa2_fornecedores AS (
  SELECT
    mdmTenantId,
    company_group,
    A2_FILIAL,
    TRIM(A2_COD) AS A2_COD,
    TRIM(A2_LOJA) AS A2_LOJA,
    A2_NOME,
    A2_CGC,
    A2_MUN,
    A2_EST,
    A2_EMAIL,
    A2_TEL,
    Deleted,
    mdmDeleted,
    protheus_pk,
    mdmEntityType,
    _ingestionDatetime,
    mdmCounterForEntity,
    ROW_NUMBER() OVER (
      PARTITION BY mdmTenantId, protheus_pk
      ORDER BY _ingestionDatetime DESC, mdmCounterForEntity DESC
    ) AS ranking
  FROM ingestion_stg_protheus_carol_sa2
  WHERE TRIM(Deleted) = 'false'
),

ct1_plano_contas AS (
  SELECT
    mdmTenantId,
    company_group,
    CT1_FILIAL,
    TRIM(CT1_CONTA) AS CT1_CONTA,
    CT1_DESC01,
    CT1_NATCTA,
    CT1_CLASSE,
    Deleted,
    mdmDeleted,
    ROW_NUMBER() OVER (
      PARTITION BY mdmTenantId, protheus_pk
      ORDER BY _ingestionDatetime DESC, mdmCounterForEntity DESC
    ) AS ranking
  FROM ingestion_stg_protheus_carol_ct1
  WHERE TRIM(Deleted) = 'false'
),

ctt_centro_custo AS (
  SELECT
    mdmTenantId,
    company_group,
    CTT_FILIAL,
    TRIM(CTT_CUSTO) AS CTT_CUSTO,
    CTT_DESC01,
    CTT_CLASSE,
    Deleted,
    mdmDeleted,
    ROW_NUMBER() OVER (
      PARTITION BY mdmTenantId, protheus_pk
      ORDER BY _ingestionDatetime DESC, mdmCounterForEntity DESC
    ) AS ranking
  FROM ingestion_stg_protheus_carol_ctt
  WHERE TRIM(Deleted) = 'false'
),

sa6_bancos AS (
  SELECT
    mdmTenantId,
    company_group,
    A6_FILIAL,
    TRIM(A6_COD) AS A6_COD,
    A6_AGENCIA,
    A6_NUMCON,
    A6_MOEDA,
    A6_TIPOCTA,
    Deleted,
    mdmDeleted,
    ROW_NUMBER() OVER (
      PARTITION BY mdmTenantId, protheus_pk
      ORDER BY _ingestionDatetime DESC, mdmCounterForEntity DESC
    ) AS ranking
  FROM ingestion_stg_protheus_carol_sa6
  WHERE TRIM(Deleted) = 'false'
),

sx5_tabelas AS (
  SELECT
    * EXCEPT(ranking)
  FROM (
    SELECT
      mdmTenantId,
      company_group,
      X5_FILIAL,
      TRIM(X5_TABELA) AS X5_TABELA,
      TRIM(X5_CHAVE) AS X5_CHAVE,
      X5_DESCRI,
      ROW_NUMBER() OVER (
        PARTITION BY mdmTenantId, company_group, X5_FILIAL, X5_TABELA, X5_CHAVE
        ORDER BY mdmCounterForEntity DESC, mdmLastUpdated DESC
      ) AS ranking
    FROM ingestion_stg_protheus_carol_sx5
    WHERE X5_TABELA IN ('05', 'A1', 'A2', 'SE', '13')
      AND TRIM(Deleted) = 'false'
  )
  WHERE ranking = 1
),

se1_receber_dataprepingestion AS (
  SELECT *
  FROM (
    SELECT *
    FROM ingestion_stg_protheus_carol_se1
    QUALIFY ROW_NUMBER() OVER (
      PARTITION BY mdmTenantId, protheus_pk
      ORDER BY _ingestionDatetime DESC, mdmCounterForEntity DESC
    ) = 1
  ) AS stg
  WHERE TRIM(Deleted) = 'false'
    AND (mdmDeleted = FALSE OR mdmDeleted IS NULL)
),

se2_pagar_dataprepingestion AS (
  SELECT *
  FROM (
    SELECT *
    FROM ingestion_stg_protheus_carol_se2
    QUALIFY ROW_NUMBER() OVER (
      PARTITION BY mdmTenantId, protheus_pk
      ORDER BY _ingestionDatetime DESC, mdmCounterForEntity DESC
    ) = 1
  ) AS stg
  WHERE TRIM(Deleted) = 'false'
    AND (mdmDeleted = FALSE OR mdmDeleted IS NULL)
),

contas_receber AS (
  SELECT
    'RECEBER' AS carteira,
    se1.mdmTenantId,
    se1.company_group,
    TRIM(se1.E1_FILIAL) AS filial,
    TRIM(se1.E1_PREFIXO) AS prefixo,
    TRIM(se1.E1_NUM) AS numero,
    TRIM(se1.E1_PARCELA) AS parcela,
    TRIM(se1.E1_TIPO) AS tipo_titulo,
    sx5_tipo.X5_DESCRI AS desc_tipo_titulo,

    TO_HEX(MD5(CONCAT(
      se1.mdmTenantId, '|RECEBER|',
      TRIM(se1.E1_FILIAL), '|',
      TRIM(se1.E1_PREFIXO), '|',
      TRIM(se1.E1_NUM), '|',
      TRIM(se1.E1_PARCELA), '|',
      TRIM(se1.E1_TIPO)
    ))) AS titulo_key,

    TRIM(se1.E1_CLIENTE) AS cod_parceiro,
    TRIM(se1.E1_LOJA) AS loja_parceiro,
    sa1.A1_NOME AS nome_parceiro,
    sa1.A1_CGC AS cnpj_cpf_parceiro,
    sa1.A1_MUN AS municipio_parceiro,
    sa1.A1_EST AS estado_parceiro,
    sa1.A1_EMAIL AS email_parceiro,

    SAFE_CAST(TRIM(se1.E1_VALOR) AS NUMERIC) AS valor_original,
    SAFE_CAST(TRIM(se1.E1_SALDO) AS NUMERIC) AS saldo_aberto,
    SAFE_CAST(TRIM(se1.E1_MULTA) AS NUMERIC) AS multa,
    SAFE_CAST(TRIM(se1.E1_JUROS) AS NUMERIC) AS juros_acumulados,
    SAFE_CAST(TRIM(se1.E1_DESCONT) AS NUMERIC) AS desconto,
    SAFE_CAST(TRIM(se1.E1_MOEDA) AS INT64) AS cod_moeda,

    PARSE_DATE('%Y%m%d', TRIM(se1.E1_EMISSAO)) AS data_emissao,
    PARSE_DATE('%Y%m%d', TRIM(se1.E1_VENCTO)) AS data_vencimento,
    PARSE_DATE('%Y%m%d', NULLIF(TRIM(se1.E1_VENCREA), '')) AS data_vencimento_real,
    PARSE_DATE('%Y%m%d', NULLIF(TRIM(se1.E1_BAIXA), '')) AS data_baixa,

    NULLIF(TRIM(se1.E1_HIST), '') AS historico,

    TRIM(se1.E1_CCUSTO) AS centro_custo,
    ctt.CTT_DESC01 AS desc_centro_custo,
    TRIM(se1.E1_NATUREZ) AS natureza_financeira,
    sx5_nat.X5_DESCRI AS desc_natureza_financeira,

    TRIM(se1.E1_PORTADO) AS cod_portador,
    sa6.A6_AGENCIA AS agencia,
    sa6.A6_NUMCON AS conta_corrente,

    se1._ingestionDatetime,
    se1.mdmCounterForEntity,
    se1.protheus_pk

  FROM se1_receber_dataprepingestion AS se1

  LEFT JOIN sa1_clientes AS sa1
    ON sa1.mdmTenantId = se1.mdmTenantId
    AND sa1.company_group = se1.company_group
    AND sa1.A1_COD = TRIM(se1.E1_CLIENTE)
    AND sa1.A1_LOJA = TRIM(se1.E1_LOJA)

  LEFT JOIN ctt_centro_custo AS ctt
    ON ctt.mdmTenantId = se1.mdmTenantId
    AND ctt.company_group = se1.company_group
    AND ctt.CTT_CUSTO = TRIM(se1.E1_CCUSTO)

  LEFT JOIN sx5_tabelas AS sx5_nat
    ON sx5_nat.mdmTenantId = se1.mdmTenantId
    AND sx5_nat.company_group = se1.company_group
    AND sx5_nat.X5_TABELA = '05'
    AND sx5_nat.X5_CHAVE = TRIM(se1.E1_NATUREZ)

  LEFT JOIN sx5_tabelas AS sx5_tipo
    ON sx5_tipo.mdmTenantId = se1.mdmTenantId
    AND sx5_tipo.company_group = se1.company_group
    AND sx5_tipo.X5_TABELA = 'A1'
    AND sx5_tipo.X5_CHAVE = TRIM(se1.E1_TIPO)

  LEFT JOIN sa6_bancos AS sa6
    ON sa6.mdmTenantId = se1.mdmTenantId
    AND sa6.company_group = se1.company_group
    AND sa6.A6_COD = TRIM(se1.E1_PORTADO)
),

contas_pagar AS (
  SELECT
    'PAGAR' AS carteira,
    se2.mdmTenantId,
    se2.company_group,
    TRIM(se2.E2_FILIAL) AS filial,
    TRIM(se2.E2_PREFIXO) AS prefixo,
    TRIM(se2.E2_NUM) AS numero,
    TRIM(se2.E2_PARCELA) AS parcela,
    TRIM(se2.E2_TIPO) AS tipo_titulo,
    sx5_tipo.X5_DESCRI AS desc_tipo_titulo,

    TO_HEX(MD5(CONCAT(
      se2.mdmTenantId, '|PAGAR|',
      TRIM(se2.E2_FILIAL), '|',
      TRIM(se2.E2_PREFIXO), '|',
      TRIM(se2.E2_NUM), '|',
      TRIM(se2.E2_PARCELA), '|',
      TRIM(se2.E2_TIPO)
    ))) AS titulo_key,

    TRIM(se2.E2_FORNECE) AS cod_parceiro,
    TRIM(se2.E2_LOJA) AS loja_parceiro,
    sa2.A2_NOME AS nome_parceiro,
    sa2.A2_CGC AS cnpj_cpf_parceiro,
    sa2.A2_MUN AS municipio_parceiro,
    sa2.A2_EST AS estado_parceiro,
    sa2.A2_EMAIL AS email_parceiro,

    SAFE_CAST(TRIM(se2.E2_VALOR) AS NUMERIC) AS valor_original,
    SAFE_CAST(TRIM(se2.E2_SALDO) AS NUMERIC) AS saldo_aberto,
    SAFE_CAST(TRIM(se2.E2_MULTA) AS NUMERIC) AS multa,
    SAFE_CAST(TRIM(se2.E2_JUROS) AS NUMERIC) AS juros_acumulados,
    SAFE_CAST(TRIM(se2.E2_DESCONT) AS NUMERIC) AS desconto,
    SAFE_CAST(TRIM(se2.E2_MOEDA) AS INT64) AS cod_moeda,

    PARSE_DATE('%Y%m%d', TRIM(se2.E2_EMISSAO)) AS data_emissao,
    PARSE_DATE('%Y%m%d', TRIM(se2.E2_VENCTO)) AS data_vencimento,
    PARSE_DATE('%Y%m%d', NULLIF(TRIM(se2.E2_VENCREA), '')) AS data_vencimento_real,
    PARSE_DATE('%Y%m%d', NULLIF(TRIM(se2.E2_BAIXA), '')) AS data_baixa,

    NULLIF(TRIM(se2.E2_HIST), '') AS historico,

    TRIM(se2.E2_CCUSTO) AS centro_custo,
    ctt.CTT_DESC01 AS desc_centro_custo,
    TRIM(se2.E2_NATUREZ) AS natureza_financeira,
    sx5_nat.X5_DESCRI AS desc_natureza_financeira,

    TRIM(se2.E2_PORTADO) AS cod_portador,
    sa6.A6_AGENCIA AS agencia,
    sa6.A6_NUMCON AS conta_corrente,

    se2._ingestionDatetime,
    se2.mdmCounterForEntity,
    se2.protheus_pk

  FROM se2_pagar_dataprepingestion AS se2

  LEFT JOIN sa2_fornecedores AS sa2
    ON sa2.mdmTenantId = se2.mdmTenantId
    AND sa2.company_group = se2.company_group
    AND sa2.A2_COD = TRIM(se2.E2_FORNECE)
    AND sa2.A2_LOJA = TRIM(se2.E2_LOJA)

  LEFT JOIN ctt_centro_custo AS ctt
    ON ctt.mdmTenantId = se2.mdmTenantId
    AND ctt.company_group = se2.company_group
    AND ctt.CTT_CUSTO = TRIM(se2.E2_CCUSTO)

  LEFT JOIN sx5_tabelas AS sx5_nat
    ON sx5_nat.mdmTenantId = se2.mdmTenantId
    AND sx5_nat.company_group = se2.company_group
    AND sx5_nat.X5_TABELA = '05'
    AND sx5_nat.X5_CHAVE = TRIM(se2.E2_NATUREZ)

  LEFT JOIN sx5_tabelas AS sx5_tipo
    ON sx5_tipo.mdmTenantId = se2.mdmTenantId
    AND sx5_tipo.company_group = se2.company_group
    AND sx5_tipo.X5_TABELA = 'A2'
    AND sx5_tipo.X5_CHAVE = TRIM(se2.E2_TIPO)

  LEFT JOIN sa6_bancos AS sa6
    ON sa6.mdmTenantId = se2.mdmTenantId
    AND sa6.company_group = se2.company_group
    AND sa6.A6_COD = TRIM(se2.E2_PORTADO)
),

visao_financeira AS (
  SELECT * FROM contas_receber
  UNION ALL
  SELECT * FROM contas_pagar
),

processedData AS (
  SELECT
    *,
    DATE_DIFF(CURRENT_DATE(), data_vencimento, DAY) AS dias_vencimento,
    CASE
      WHEN data_vencimento IS NULL THEN 'Sem vencimento'
      WHEN data_baixa IS NOT NULL THEN 'Liquidado'
      WHEN DATE_DIFF(CURRENT_DATE(), data_vencimento, DAY) > 360 THEN 'Vencido > 360 dias'
      WHEN DATE_DIFF(CURRENT_DATE(), data_vencimento, DAY) > 180 THEN 'Vencido 181-360 dias'
      WHEN DATE_DIFF(CURRENT_DATE(), data_vencimento, DAY) > 90 THEN 'Vencido 91-180 dias'
      WHEN DATE_DIFF(CURRENT_DATE(), data_vencimento, DAY) > 30 THEN 'Vencido 31-90 dias'
      WHEN DATE_DIFF(CURRENT_DATE(), data_vencimento, DAY) > 0 THEN 'Vencido 1-30 dias'
      WHEN DATE_DIFF(data_vencimento, CURRENT_DATE(), DAY) BETWEEN 0 AND 7 THEN 'Vence em ate 7 dias'
      WHEN DATE_DIFF(data_vencimento, CURRENT_DATE(), DAY) BETWEEN 8 AND 30 THEN 'Vence em ate 30 dias'
      ELSE 'A vencer > 30 dias'
    END AS faixa_aging,
    FORMAT_DATE('%Y-%m', data_vencimento) AS competencia_vencimento,
    FORMAT_DATE('%Y-%m', data_emissao) AS competencia_emissao,
    TRIM(CONCAT(
      'Carteira: ', carteira, '. ',
      'Titulo: ', prefixo, '-', numero, '-', parcela,
      IF(desc_tipo_titulo IS NOT NULL, CONCAT(' (', desc_tipo_titulo, ')'), ''), '. ',
      'Parceiro: ', COALESCE(nome_parceiro, 'Nao informado'),
      IF(cnpj_cpf_parceiro IS NOT NULL, CONCAT(' - CNPJ/CPF: ', cnpj_cpf_parceiro), ''),
      IF(municipio_parceiro IS NOT NULL,
         CONCAT(' - ', municipio_parceiro, '/', COALESCE(estado_parceiro, '')), ''), '. ',
      'Valor original: R$ ', FORMAT('%.2f', COALESCE(valor_original, 0)), '. ',
      'Saldo em aberto: R$ ', FORMAT('%.2f', COALESCE(saldo_aberto, 0)), '. ',
      IF(multa > 0,
         CONCAT('Multa: R$ ', FORMAT('%.2f', multa), '. '), ''),
      IF(juros_acumulados > 0,
         CONCAT('Juros: R$ ', FORMAT('%.2f', juros_acumulados), '. '), ''),
      'Emissao: ', COALESCE(FORMAT_DATE('%d/%m/%Y', data_emissao), 'nao informada'), '. ',
      'Vencimento: ', COALESCE(FORMAT_DATE('%d/%m/%Y', data_vencimento), 'nao informado'), '. ',
      IF(desc_natureza_financeira IS NOT NULL,
         CONCAT('Natureza financeira: ', desc_natureza_financeira, '. '), ''),
      IF(desc_centro_custo IS NOT NULL,
         CONCAT('Centro de custo: ', desc_centro_custo, '. '), ''),
      IF(agencia IS NOT NULL,
         CONCAT('Portador: ag. ', agencia,
           IF(conta_corrente IS NOT NULL, CONCAT(' / cc. ', conta_corrente), ''), '. '), ''),
      IF(historico IS NOT NULL,
         CONCAT('Historico: ', historico, '.'), '')
    )) AS text_concat
  FROM visao_financeira
),

embeddedData AS (
  SELECT
    * EXCEPT(ml_generate_embedding_result, ml_generate_embedding_statistics, ml_generate_embedding_status),
    ml_generate_embedding_result AS embedded_content_128
  FROM ML.GENERATE_EMBEDDING(
    MODEL `ideia-dataops-prod.models.text_embedder`,
    (SELECT *, text_concat AS content FROM processedData),
    STRUCT(TRUE AS flatten_json_output, 'RETRIEVAL_DOCUMENT' AS task_type, 128 AS OUTPUT_DIMENSIONALITY)
  )
)

SELECT * FROM embeddedData
